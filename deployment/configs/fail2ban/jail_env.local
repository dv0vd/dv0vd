[DEFAULT]
findtime          = 10m
maxretry          = 25
bantime           = -1
nginx_access_log  = /root/dv0vd/deployment/data/nginx/logs/access.log
nginx_error_log   = /root/dv0vd/deployment/data/nginx/logs/error.log
banaction         = %(banaction_allports)s
ignoreip          = $FAIL2BAN_IGNORE_IPS

[sshd]
enabled = true
backend = systemd
mode    = aggressive

[nginx-http-auth]
enabled = true
mode    = aggressive
logpath = %(nginx_access_log)s

[nginx-limit-req]
enabled = true
logpath = %(nginx_error_log)s

[nginx-botsearch]
enabled  = true
logpath  = %(nginx_access_log)s

[nginx-bad-request]
enabled = true
logpath = %(nginx_access_log)s

[nginx-not-found]
enabled  = true
logpath  = %(nginx_access_log)s
maxretry = 10

[nginx-redirected]
enabled  = true
logpath  = %(nginx_access_log)s
maxretry = 10

[danted]
enabled = true
filter  = danted
logpath = /root/dv0vd/deployment/data/socks5/logs/danted.log
backend = auto

[postfix]
enabled  = true
filter   = postfix
logpath  = /root/dv0vd/deployment/data/email/logs/mail.log

[dovecot]
enabled  = true
filter   = dovecot
logpath  = /root/dv0vd/deployment/data/email/logs/mail.log
