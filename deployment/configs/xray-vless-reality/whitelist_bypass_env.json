{
  "log": {
    "loglevel": "debug"
  },
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": 1080,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "$PROXY_MAIN_URL.$BASE_URL",
            "port": 443,
            "users": [
              {
                "id": "$XRAY_VLESS_REALITY_UUID",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "$PROXY_MAIN_URL.$BASE_URL",
          "alpn": [
            "h2"
          ]
        },
        "xhttpSettings": {
          "path": "/v2/events",
          "mode": "packet-up"
        }
      }
    }
  ]
}