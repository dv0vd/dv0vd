{
  "log": {
    "loglevel": "debug"
  },
  "inbounds": [
    {
      "tag": "socks-in",
      "listen": "0.0.0.0",
      "port": 1080,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      }
    }
  ],
  "outbounds": [],
  "routing": {
    "rules": [
      {
        "type": "field",
        "domain": [
          "$GATEWAY_URL.$BASE_URL"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "inboundTag": [
          "socks-in"
        ],
        "balancerTag": "proxy-balance"
      }
    ],
    "balancers": [
      {
        "tag": "proxy-balance",
        "selector": [],
        "strategy": {
          "type": "leastPing"
        },
        "fallbackTag": "direct"
      }
    ]
  },
  "observatory": {
    "subjectSelector": [],
    "probeUrl": "https://cp.cloudflare.com/generate_204",
    "probeInterval": "15s",
    "enableConcurrency": true
  }
}
