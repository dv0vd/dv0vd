{
  "log": {
    "loglevel": "debug"
  },
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": 1080,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "$PROXY_MAIN_URL.$BASE_URL",
            "port": 443,
            "users": [
              {
                "id": "$XRAY_VLESS_REALITY_UUID",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "tls",
        "finalmask": {
          "tcp": [
            {
              "type": "fragment",
              "settings": {
                "packets": "tlshello",
                "lengths": [
                  "1-2",
                  "3-5",
                  "5-10",
                  "6-10"
                ],
                "delays": [
                  "1-3"
                ],
                "maxSplit": "25-32"
              }
            }
          ]
        },
        "tlsSettings": {
          "serverName": "$PROXY_MAIN_URL.$BASE_URL",
          "fingerprint": "firefox",
          "alpn": [
            "h2"
          ]
        },
        "xhttpSettings": {
          "path": "/v2/events",
          "mode": "stream-up",
          "xmux": {
            "maxConcurrency": 8
          },
          "xPaddingBytes": "100-1000",
          "xPaddingObfsMode": true,
          "xPaddingKey": "ts",
          "xPaddingHeader": "Referer",
          "xPaddingPlacement": "queryInHeader",
          "xPaddingMethod": "tokenish"
        },
        "sockopt": {
          "tcpKeepAliveIdle": 60,
          "tcpKeepAliveInterval": 15
        }
      }
    }
  ]
}