{
  "log": {
    "loglevel": "debug"
  },
  "inbounds": [
    {
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "$XRAY_VLESS_REALITY_UUID",
            "flow": "xtls-rprx-vision"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "raw",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "$BASE_URL:443",
          "xver": 0,
          "serverNames": [
            "www.$BASE_URL",
            "$BASE_URL"
          ],
          "privateKey": "$XRAY_VLESS_REALITY_PRIVATE_KEY",
          "minClientVer": "0.0.0",
          "maxClientVer": "",
          "maxTimeDiff": 0,
          "shortIds": [
            "$XRAY_VLESS_REALITY_USER0",
            "$XRAY_VLESS_REALITY_USER1",
            "$XRAY_VLESS_REALITY_USER2",
            "$XRAY_VLESS_REALITY_USER3",
            "$XRAY_VLESS_REALITY_USER4",
            "$XRAY_VLESS_REALITY_USER5",
            "$XRAY_VLESS_REALITY_USER6",
            "$XRAY_VLESS_REALITY_USER7",
            "$XRAY_VLESS_REALITY_USER8",
            "$XRAY_VLESS_REALITY_USER9",
            "$XRAY_VLESS_REALITY_USER10"
          ]
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls"
        ]
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "$PROXY_MAIN_URL.$BASE_URL",
            "port": 443,
            "users": [
              {
                "id": "$XRAY_VLESS_REALITY_UUID",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "tls",
        "finalmask": {
          "tcp": [
            {
              "type": "fragment",
              "settings": {
                "packets": "tlshello",
                "lengths": [
                  "1-2",
                  "3-5",
                  "5-10",
                  "6-10"
                ],
                "delays": [
                  "1-3"
                ],
                "maxSplit": "25-32"
              }
            }
          ]
        },
        "tlsSettings": {
          "serverName": "$PROXY_MAIN_URL.$BASE_URL",
          "fingerprint": "firefox",
          "alpn": [
            "h2"
          ]
        },
        "xhttpSettings": {
          "path": "/v2/events",
          "mode": "stream-up",
          "xmux": {
            "maxConcurrency": 8
          },
          "xPaddingBytes": "100-1000",
          "xPaddingObfsMode": true,
          "xPaddingKey": "ts",
          "xPaddingHeader": "Referer",
          "xPaddingPlacement": "queryInHeader",
          "xPaddingMethod": "tokenish"
        },
        "sockopt": {
          "tcpKeepAliveIdle": 60,
          "tcpKeepAliveInterval": 15
        }
      }
    }
  ]
}