{
  "log": {
    "loglevel": "debug"
  },
  "inbounds": [
    {
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "$XRAY_VLESS_REALITY_UUID"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "sockopt": {
          "trustedXForwardedFor": [
            "X-Real-IP"
          ]
        },
        "xhttpSettings": {
          "path": "/v2/events",
          "mode": "auto",
          "xPaddingBytes": "100-1000",
          "xPaddingObfsMode": true,
          "xPaddingKey": "ts",
          "xPaddingHeader": "Referer",
          "xPaddingPlacement": "queryInHeader",
          "xPaddingMethod": "tokenish"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls"
        ]
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"
    }
  ]
}