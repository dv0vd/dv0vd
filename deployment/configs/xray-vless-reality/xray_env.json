{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "$XRAY_VLESS_REALITY_UUID",
            "flow": "xtls-rprx-vision"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "raw",
        "security": "reality",
        "realitySettings": {
          "show": true,
          "dest": "$BASE_URL:443",
          "xver": 0,
          "serverNames": [
            "www.$BASE_URL",
            "$BASE_URL"
          ],
          "privateKey": "$XRAY_VLESS_REALITY_PRIVATE_KEY",
          "minClientVer": "",
          "maxClientVer": "",
          "maxTimeDiff": 0,
          "shortIds": [
            "$XRAY_VLESS_REALITY_USER0",
            "$XRAY_VLESS_REALITY_USER1",
            "$XRAY_VLESS_REALITY_USER2",
            "$XRAY_VLESS_REALITY_USER3",
            "$XRAY_VLESS_REALITY_USER4",
            "$XRAY_VLESS_REALITY_USER5",
            "$XRAY_VLESS_REALITY_USER6",
            "$XRAY_VLESS_REALITY_USER7",
            "$XRAY_VLESS_REALITY_USER8",
            "$XRAY_VLESS_REALITY_USER9",
            "$XRAY_VLESS_REALITY_USER10"
          ]
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls"
        ]
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    }
  ]
}
